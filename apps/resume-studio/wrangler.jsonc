{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futureproof-resume-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "vars": {
    "APP_URL": "https://resume.askfutureproof.com",
    "AI_MODEL": "gpt-4.1-mini",
    "PAYMENTS_ENABLED": "false",
    "DESYGN_PORTAL_URL": ""
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "futureproof-resume-studio",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "resume.askfutureproof.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}
